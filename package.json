{
  "name": "plandesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@libsql/kysely-libsql>@libsql/client": "^0.15.9",
      "@types/node": "25.9.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && prettier --check .",
    "validate": "bash scripts/validate.sh",
    "metrics": "node scripts/metrics.mjs",
    "test:contract": "pnpm test && pnpm validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:e2e": "bash scripts/release-e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncdotengineering/plandesk.git"
  }
}
