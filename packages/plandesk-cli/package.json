    "@plandesk/mcp": "workspace:*",
    "hono": "^4.12.23",
    "marked": "^18.0.5",
    "marked-shiki": "^1.2.1",
    "mermaid": "^11.16.0",
    "shiki": "^4.3.1"
  },
  "description": "Plan Desk CLI — run a local-first planning workspace (canvas + docs + tasks + board + MCP). Provides the `plandesk` command.",
