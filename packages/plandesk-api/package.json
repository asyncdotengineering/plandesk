{
  "name": "@plandesk/api",
  "version": "2.5.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src",
    "prepack": "node -e \"const fs=require('fs');const s='../../apps/plandesk-web/dist';if(fs.existsSync(s)){fs.rmSync('web',{recursive:true,force:true});fs.cpSync(s,'web',{recursive:true});console.log('bundled web SPA')}else{console.warn('web dist missing; published serve will lack UI')}\"",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250609.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "@hono/node-server": "^2.0.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "@plandesk/db": "workspace:*",
    "better-auth": "1.6.23",
    "hono": "^4.12.23"
  },
  "description": "Plan Desk REST + SSE API and service layer (local-first planning workspace).",
  "license": "MIT",
  "author": "asyncdotengineering",
  "homepage": "https://plandesk.asyncdot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncdotengineering/plandesk.git",
    "directory": "packages/plandesk-api"
  },
  "keywords": [
    "plan-desk",
    "planning",
    "canvas",
    "mcp",
    "agents",
    "local-first",
    "kanban",
    "tasks"
  ]
}
