{
  "name": "@plandesk/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hosted Plan Desk entries (Cloudflare Workers, Vercel) over one createHostedApp composition of the API and MCP apps. Not published.",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "deploy": "wrangler deploy -c wrangler.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@plandesk/api": "workspace:*",
    "@plandesk/db": "workspace:*",
    "@plandesk/mcp": "workspace:*",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.98.0",
    "vitest": "^3.2.4"
  }
}
