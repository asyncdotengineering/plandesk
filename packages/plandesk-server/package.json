{
  "name": "@plandesk/server",
  "version": "5.0.0",
  "type": "module",
  "description": "Plan Desk server composition: the REST API and MCP apps over a self-prepared database, with Node, Cloudflare Workers and Vercel entries.",
  "exports": {
    ".": {
      "types": "./dist/hosted-app.d.ts",
      "import": "./dist/hosted-app.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "dependencies": {
    "@plandesk/api": "workspace:*",
    "@plandesk/db": "workspace:*",
    "@plandesk/mcp": "workspace:*",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "author": "asyncdotengineering",
  "homepage": "https://plandesk.asyncdot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncdotengineering/plandesk.git",
    "directory": "packages/plandesk-server"
  },
  "keywords": [
    "plan-desk",
    "planning",
    "mcp",
    "agents",
    "self-hosted",
    "cloudflare-workers",
    "vercel"
  ]
}
