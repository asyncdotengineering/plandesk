{
  "name": "@plandesk/db",
  "version": "2.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/client-web.d.ts",
      "import": "./dist/client-web.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "generate": "drizzle-kit generate",
    "migrate:kit": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.15.9",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "description": "Plan Desk persistence layer (Drizzle + SQLite schema, migrations, repositories).",
  "license": "MIT",
  "author": "asyncdotengineering",
  "homepage": "https://plandesk.asyncdot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncdotengineering/plandesk.git",
    "directory": "packages/plandesk-db"
  },
  "keywords": [
    "plan-desk",
    "planning",
    "canvas",
    "mcp",
    "agents",
    "local-first",
    "kanban",
    "tasks"
  ]
}
