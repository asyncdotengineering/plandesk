# Plan Desk server settings. `cp .env.example .env` for `docker compose up`;
# `plandesk serve` reads the same names from its environment. Blank means unset.

# Required off loopback: the password for the web UI and REST API (HTTP Basic, user "plandesk").
PLANDESK_AUTH_PASSWORD=
# Required with a remote database: signs sessions and API keys. `openssl rand -hex 32`.
PLANDESK_BETTER_AUTH_SECRET=

# Public URL the server is reached at (sign-in callbacks, share links).
PLANDESK_BASE_URL=
# Bind address for `plandesk serve` (default 127.0.0.1); the image binds 0.0.0.0.
PLANDESK_HOST=
# Port for `plandesk serve` (default 7526); the image always listens on 7526.
PLANDESK_PORT=
# Host port compose publishes the server on (compose only, default 7526).
PLANDESK_HOST_PORT=

# libSQL/Turso database URL. Unset: a SQLite file in the data directory.
PLANDESK_DB_URL=
# Auth token for PLANDESK_DB_URL.
PLANDESK_DB_TOKEN=

# Where file bytes live: "db" (default, in the database) or "s3".
PLANDESK_STORAGE=
# S3 bucket name (PLANDESK_STORAGE=s3).
PLANDESK_S3_BUCKET=
# S3 region, e.g. us-east-1 or "auto" for R2.
PLANDESK_S3_REGION=
# S3 access key id.
PLANDESK_S3_ACCESS_KEY_ID=
# S3 secret access key.
PLANDESK_S3_SECRET_ACCESS_KEY=
# S3-compatible endpoint (R2, MinIO, ...). Unset: AWS.
PLANDESK_S3_ENDPOINT=

# GitHub sign-in: set all three, or none to run without it.
PLANDESK_GITHUB_CLIENT_ID=
# GitHub OAuth app client secret.
PLANDESK_GITHUB_CLIENT_SECRET=
# Callback URL registered on the GitHub app, e.g. https://plandesk.example.com/api/auth/callback/github.
PLANDESK_GITHUB_CALLBACK_URL=
# Where to send the browser after GitHub sign-in (optional).
PLANDESK_DASHBOARD_URL=
